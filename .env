## Vector DB 설정
# Vector DB 전략 선택: MEMORY | CHROMA | 
# VECTOR_STORE_STRATEGY=MEMORY
VECTOR_STORE_STRATEGY=CHROMA

--

# Chroma DB 연결 정보
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=rag_collection

--
## 메타 데이터
# 메타데이터 추출 방식: RULE_BASED | AI_BASED | 
METADATA_STRATEGY=OPENAI_BASED
# METADATA_STRATEGY=RULE_BASED

# 메타데이터 추출용 AI 모델 설정
METADATA_AI_MODEL=gpt-4o-mini

# -- AI 지시사항 (Prompts)
# 메타데이터 추출용 가이드
METADATA_SYSTEM_PROMPT="You are a professional librarian. Extract metadata from the document in JSON format.
                        Fields:
                        - title: Short, descriptive title.
                        - docType: One of ['runbook', 'policy', 'adr', 'manual'].
                        - permission: Array of roles ['USER', 'MANAGER', 'ADMIN']. Decide based on content sensitivity.
                        - summary: A one-sentence summary of the document."

--

## 채팅
# 채팅(RAG)용 모델 및 파라미터
CHAT_AI_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0
MAX_CONTEXT_LENGTH=3000

# -- AI 지시사항 (Prompts)
# 채팅 답변용 가이드 (RAG)
CHAT_SYSTEM_PROMPT="당신은 전문 기술 비서입니다. 제공된 지식만 참고하여 답변하세요. 지식에 없는 내용이라면 모른다고 솔직하게 답하세요."